                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const item = pm.response.json();",
                  "pm.test('devolve a OS com execucaoId e posição', () => {",
                  "    pm.expect(item.osId).to.eql(pm.collectionVariables.get('osId'));",
                  "    pm.expect(item.execucaoId).to.be.a('string');",
                  "    pm.expect(item.prioridade).to.eql(5);",
                  "    pm.expect(item.posicao).to.be.at.least(1);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('execucaoId', item.execucaoId);",
                  "}"
                ]
              }
            }
