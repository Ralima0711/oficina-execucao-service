APP_NAME="Oficina Execucao Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stdout_json
LOG_LEVEL=info

# OpenTelemetry — exportacao OTLP/HTTP (New Relic ou coletor local).
# A license key vai no header (OTEL_EXPORTER_OTLP_HEADERS) e deve vir de Secret.
# Sem OTEL_EXPORTER_OTLP_ENDPOINT o provider vira no-op (nao exporta, nao quebra).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=oficina-execucao-service
